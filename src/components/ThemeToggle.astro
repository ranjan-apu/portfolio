---

<button type="button" id="theme-toggle" aria-label="Toggle day/night theme" title="Toggle theme">
  <span class="icon moon" aria-hidden="true">🌙</span>
  <span class="icon sun" aria-hidden="true">☀️</span>
</button>

<script>
  (function () {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    function apply(theme: 'day' | 'night') {
      document.documentElement.setAttribute('data-theme', theme);
      localStorage.setItem('theme', theme);
    }

    btn.addEventListener('click', function () {
      const current = document.documentElement.getAttribute('data-theme') === 'day' ? 'day' : 'night';
      apply(current === 'day' ? 'night' : 'day');
    });
  })();
</script>

<style>
  button {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--fg-muted);
    border-radius: var(--radius);
    padding: var(--space-xs) var(--space-sm);
    cursor: pointer;
    font: inherit;
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
  }
  button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .icon {
    display: inline-block;
  }
  :root[data-theme='night'] .sun,
  [data-theme='night'] .sun {
    display: none;
  }
  :root[data-theme='day'] .moon,
  [data-theme='day'] .moon {
    display: none;
  }
</style>
