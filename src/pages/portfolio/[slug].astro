---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { caseStudies, type CaseStudy } from '../../data/caseStudies';
import { workProjects } from '../../data/projects';
import { topicUrl, topicLabel } from '../../lib/posts';
import { SOCIAL } from '../../consts';

export function getStaticPaths() {
  return caseStudies.map((study) => ({ params: { slug: study.slug }, props: { study } }));
}

interface Props {
  study: CaseStudy;
}
const { study } = Astro.props;
const project = workProjects.find((item) => item.caseStudySlug === study.slug);
const nextStudy =
  caseStudies[(caseStudies.findIndex((item) => item.slug === study.slug) + 1) % caseStudies.length];
---

<BaseLayout
  title={`${study.projectName} — Engineering case study`}
  description={study.introduction}
  ogType="article"
  articleDate={`${study.date}T00:00:00.000Z`}
  articleTags={project?.categories}
  breadcrumbParent={{ label: 'Projects', href: '/portfolio/' }}
  ogImage={`/og/portfolio/${study.slug}.png`}
>
  <article class="container case-study">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/portfolio/">Projects</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Case study</span>
    </nav>

    <header class="case-header">
      <h1>{study.headline}</h1>
      <p class="lede">{study.introduction}</p>
      <div class="project-context">
        <span class="project-name">{study.projectName}</span>
        <span>Walmart Global Tech · Internal platform</span>
        <span>{project?.categories.map((category) => topicLabel(category)).join(' / ')}</span>
      </div>
    </header>

    <div class="story-grid">
      <aside class="story-index" aria-label="On this page">
        <p>In this case study</p>
        <a href="#context">The challenge</a>
        <a href="#approach">System approach</a>
        <a href="#considerations">Engineering considerations</a>
        <a href="#outcome">Scope and outcome</a>
      </aside>
      <div class="story-content">
        <section id="context">
          <h2>The challenge</h2>
          {study.context.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </section>
        <section id="approach">
          <h2>System approach</h2>
          {study.approach.map((item) => (
            <div class="story-point">
              <h3>{item.title}</h3>
              <p>{item.detail}</p>
            </div>
          ))}
        </section>
        <section id="considerations">
          <h2>Engineering considerations</h2>
          <p class="section-context">
            These are design principles the work raises, rather than a claim about private
            architecture or unreported implementation choices.
          </p>
          {study.engineeringLens.map((item) => (
            <div class="story-point">
              <h3>{item.title}</h3>
              <p>{item.detail}</p>
            </div>
          ))}
        </section>
        <section id="outcome">
          <h2>Scope and outcome</h2>
          <p>{study.outcome}</p>
          <p class="disclosure">{study.boundary}</p>
        </section>
      </div>
    </div>

    <footer class="case-end">
      <div>
        <h2>Explore the thinking behind the work.</h2>
        <p>More practical notes on the engineering problems that connect these projects.</p>
        <a href={topicUrl(study.readingTag)}>
          Read related writing <Icon name="arrow-up-right" />
        </a>
      </div>
      <div>
        <h2>Next case study</h2>
        <a class="next-study" href={`/portfolio/${nextStudy.slug}/`}>
          {nextStudy.projectName} <Icon name="arrow-up-right" />
        </a>
        <p>
          <a href={SOCIAL.email}>
            Get in touch <Icon name="arrow-up-right" />
          </a>
        </p>
      </div>
    </footer>
  </article>
</BaseLayout>

<style>
  .case-study {
    --max-width: 1040px;
  }
  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    font: 0.875rem/1.5 var(--font-mono);
    color: var(--fg-muted);
    margin-bottom: clamp(2rem, 6vw, 4rem);
  }
  .breadcrumbs a {
    color: var(--fg-muted);
  }
  .breadcrumbs a:hover {
    color: var(--accent);
  }
  .case-header {
    max-width: 820px;
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--border);
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .project-name {
    color: var(--accent);
  }
  h1 {
    font-size: clamp(2.3rem, 4.6vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: -0.028em;
    max-width: 21ch;
    text-wrap: wrap;
    margin: 0 0 1.4rem;
  }
  .lede {
    font: 400 clamp(1.1rem, 2vw, 1.35rem)/1.58 var(--font-head);
    color: var(--fg-muted);
    max-width: 55ch;
  }
  .project-context {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    font: var(--text-meta)/1.6 var(--font-mono);
    color: var(--fg-dim);
    font-variant-numeric: tabular-nums;
  }
  .story-grid {
    display: grid;
    grid-template-columns: minmax(170px, 225px) minmax(0, 680px);
    gap: clamp(2rem, 6vw, 5.5rem);
    align-items: start;
  }
  .story-index {
    position: sticky;
    top: 8rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }
  .story-index p {
    font: 600 var(--text-label)/1.5 var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin: 0 0 0.4rem;
  }
  .story-index a {
    font-size: var(--text-meta);
    color: var(--fg-muted);
    text-decoration: none;
  }
  .story-index a:hover {
    color: var(--accent);
  }
  .story-content section {
    scroll-margin-top: 8rem;
    margin-bottom: clamp(2.6rem, 5vw, 4.25rem);
  }
  .story-content h2 {
    font-size: clamp(1.65rem, 2.8vw, 2.1rem);
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }
  .story-content h3 {
    font: var(--fw-head) clamp(1.15rem, 1.9vw, 1.35rem)/1.25 var(--font-head);
    margin: 0 0 0.5rem;
  }
  .story-content p {
    font-size: var(--text-body);
    line-height: 1.78;
    color: var(--fg-muted);
    max-width: 68ch;
  }
  .story-point {
    padding: 1.25rem 0 0;
    margin-top: 1.25rem;
    border-top: 1px solid var(--border);
  }
  .section-context {
    color: var(--fg-dim) !important;
    font-size: 0.94rem !important;
  }
  .disclosure {
    border-top: 1px solid var(--border);
    padding-top: 1.2rem;
    font-size: 0.91rem !important;
  }
  .case-end {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    border-top: 1px solid var(--border);
    padding: 2rem 0 3rem;
  }
  .case-end h2 {
    font-size: 1.5rem;
    margin: 0 0 0.75rem;
  }
  .case-end p {
    color: var(--fg-muted);
  }
  .case-end a {
    font-size: var(--text-ui);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .next-study {
    font: var(--fw-head) 1.15rem/1.35 var(--font-head) !important;
  }
  @media (max-width: 760px) {
    .story-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .story-index {
      position: static;
      display: none;
    }
    .case-end {
      grid-template-columns: 1fr;
    }
  }
</style>
