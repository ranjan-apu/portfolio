---
import Nav from './Nav.astro';
import SocialIcon from './SocialIcon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { SITE_NAME, SOCIAL } from '../consts';
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="site-title" aria-label={`${SITE_NAME} home`}>
      {SITE_NAME}
    </a>

    <div class="header-nav">
      <Nav />
    </div>

    <div class="header-actions">
      <a href={SOCIAL.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <SocialIcon name="github" />
      </a>
      <a href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
        <SocialIcon name="linkedin" />
      </a>
      <a href={SOCIAL.x} target="_blank" rel="noopener noreferrer" aria-label="X">
        <SocialIcon name="x" />
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    padding: var(--space-md) 0;
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    min-height: 2.25rem;
  }
  .site-title {
    font-family: var(--font-head);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--fg);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    line-height: 1;
  }
  .site-title:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .header-nav {
    margin-left: auto;
    display: flex;
    align-items: center;
    min-height: 2.25rem;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-shrink: 0;
  }
  .header-actions a {
    color: var(--fg-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    line-height: 1;
    border-radius: var(--radius);
    text-decoration: none;
  }
  .header-actions a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .header-actions a:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 2px;
  }
  .header-actions svg {
    width: 1.2rem;
    height: 1.2rem;
    display: block;
  }

  @media (max-width: 720px) {
    .site-header {
      padding: var(--space-sm) 0;
    }
    .header-inner {
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "brand actions"
        "nav   nav";
      row-gap: var(--space-xs);
      column-gap: var(--space-md);
      align-items: center;
    }
    .site-title {
      grid-area: brand;
      font-size: 1.35rem;
    }
    .header-actions {
      grid-area: actions;
      gap: var(--space-xs);
    }
    .header-nav {
      grid-area: nav;
      width: 100%;
      margin-left: 0;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
      padding-top: var(--space-xs);
      border-top: 1px solid var(--border);
    }
    .header-nav::-webkit-scrollbar {
      display: none;
    }
  }
</style>
