---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Icon from '../../components/Icon.astro';
import { publishedPosts, topicSlug, topicLabel, topicsFor, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return topicsFor(posts).map((topic) => ({
    params: { tag: topic.slug },
    props: {
      topic,
      posts: posts.filter((post) => post.data.tags.some((tag) => topicSlug(tag) === topic.slug)),
    },
  }));
}

interface Props {
  topic: { name: string; label?: string; slug: string; count: number };
  posts: Post[];
}
const { topic, posts } = Astro.props;
const label = topic.label ?? topicLabel(topic.name);
---

<BaseLayout
  title={`Writing about ${label}`}
  description={`Browse ${topic.count} ${topic.count === 1 ? 'article' : 'articles'} about ${label} by Apurba.`}
>
  <div class="container topic-page">
    <nav aria-label="Breadcrumb">
      <a href="/archives/">
        <Icon name="arrow-left" /> All writing
      </a>
    </nav>
    <header>
      <h1>{label}</h1>
      <p class="text-muted">
        {topic.count} {topic.count === 1 ? 'article' : 'articles'} on this topic.
      </p>
    </header>
    <section aria-labelledby="topic-articles">
      <h2 id="topic-articles" class="sr-only">
        Articles about {label}
      </h2>
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </section>
  </div>
</BaseLayout>

<style>
  nav {
    margin-bottom: var(--space-lg);
    font-size: var(--text-meta);
  }
  nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.5rem;
  }
  header {
    margin-bottom: var(--space-xl);
  }
  h1 {
    margin-bottom: 0.5rem;
  }
</style>
