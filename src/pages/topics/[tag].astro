---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { publishedPosts, topicSlug, topicsFor, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return topicsFor(posts).map(topic => ({
    params: { tag: topic.slug },
    props: { topic, posts: posts.filter(post => post.data.tags.some(tag => topicSlug(tag) === topic.slug)) },
  }));
}

interface Props {
  topic: { name: string; slug: string; count: number };
  posts: Post[];
}
const { topic, posts } = Astro.props;
---

<BaseLayout title={`Writing about ${topic.name}`} description={`Browse ${topic.count} ${topic.count === 1 ? 'article' : 'articles'} about ${topic.name} by Apurba.`}>
  <div class="container topic-page">
    <nav aria-label="Breadcrumb"><a href="/archives/">← All writing</a></nav>
    <header>
      <p class="eyebrow">Explore a topic</p>
      <h1>{topic.name}</h1>
      <p class="text-muted">{topic.count} {topic.count === 1 ? 'article' : 'articles'} on this topic.</p>
    </header>
    <section aria-label={`${topic.name} articles`}>
      {posts.map(post => <PostCard post={post} />)}
    </section>
  </div>
</BaseLayout>

<style>
  nav { margin-bottom: var(--space-lg); font-size: .85rem; }
  header { margin-bottom: var(--space-xl); }
  .eyebrow { color: var(--accent); font-size: .75rem; text-transform: uppercase; letter-spacing: .12em; margin-bottom: .5rem; }
  h1 { text-transform: none; margin-bottom: .5rem; }
</style>
