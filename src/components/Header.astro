---
import Nav from './Nav.astro';
import ThemeToggle from './ThemeToggle.astro';
import { SITE_NAME, SOCIAL } from '../consts';
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="site-title" aria-label={`${SITE_NAME} home`}>
      {SITE_NAME}
    </a>

    <div class="header-nav">
      <Nav />
    </div>

    <div class="header-actions">
      <a href={SOCIAL.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
          <path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02A9.78 9.78 0 0 1 12 6.85c.85.004 1.71.11 2.51.32 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2Z"/>
        </svg>
      </a>
      <a href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
          <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.55V9h3.57v11.45z"/>
        </svg>
      </a>
      <a href={SOCIAL.x} target="_blank" rel="noopener noreferrer" aria-label="X">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    padding: var(--space-md) 0;
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
  }
  .site-title {
    font-family: var(--font-head);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--fg);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }
  .site-title:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .header-nav {
    margin-left: auto;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-shrink: 0;
  }
  .header-actions a {
    color: var(--fg-muted);
    display: flex;
    align-items: center;
  }
  .header-actions a:hover {
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .site-header {
      padding: var(--space-sm) 0;
    }
    .header-inner {
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "brand actions"
        "nav   nav";
      row-gap: var(--space-xs);
      column-gap: var(--space-md);
      align-items: center;
    }
    .site-title {
      grid-area: brand;
      font-size: 1.35rem;
    }
    .header-actions {
      grid-area: actions;
      gap: var(--space-sm);
    }
    .header-nav {
      grid-area: nav;
      width: 100%;
      margin-left: 0;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-top: var(--space-xs);
      border-top: 1px solid var(--border);
    }
    .header-nav::-webkit-scrollbar {
      display: none;
    }
  }
</style>
