---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Saved articles" description="Your locally saved reading list." noindex>
  <div class="container saved-page">
    <nav><a href="/archives/">← All writing</a></nav>
    <header><h1>Saved articles</h1><p class="text-muted">Your reading list stays in this browser. No account needed.</p></header>
    <p id="saved-count" role="status" aria-live="polite">Loading saved articles…</p>
    <ul id="saved-list"></ul>
    <noscript>Enable JavaScript to view saved articles.</noscript>
  </div>
</BaseLayout>

<script>
  import { getSavedPosts, removeSavedPost } from '../lib/bookmarks';
  function initSavedPage() {
    const list = document.getElementById('saved-list');
    const status = document.getElementById('saved-count');
    if (!list || !status) return;
    function render() {
      const items = getSavedPosts();
      status!.textContent = items.length ? `${items.length} saved ${items.length === 1 ? 'article' : 'articles'}` : 'No saved articles yet. Visit a post and choose “Save for later”.';
      list!.replaceChildren();
      for (const item of items) {
        const li = document.createElement('li');
        const link = document.createElement('a'); link.href = item.href; link.textContent = item.title;
        const description = document.createElement('p'); description.textContent = item.description;
        const remove = document.createElement('button'); remove.type = 'button'; remove.textContent = 'Remove';
        remove.addEventListener('click', () => {
          try { removeSavedPost(item.href); render(); }
          catch { status!.textContent = 'Could not update saved articles in this browser.'; }
        });
        li.append(link, description, remove); list!.appendChild(li);
      }
    }
    render();
  }
  document.addEventListener('astro:page-load', initSavedPage);
</script>

<style>
  nav { margin-bottom: var(--space-lg); font-size: .85rem; }
  header { margin-bottom: var(--space-xl); }
  #saved-count { color: var(--fg-muted); font-size: .88rem; }
  ul { padding: 0; list-style: none; }
  li { border-top: 1px solid var(--border); padding: var(--space-lg) 0; }
  li a { font: 700 1.3rem var(--font-head); }
  li p { color: var(--fg-muted); font-size: .9rem; margin: .45rem 0; }
  li button { font: inherit; cursor: pointer; border: 0; padding: .3rem 0; color: var(--accent); background: none; }
</style>
