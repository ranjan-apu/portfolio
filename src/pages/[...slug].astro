---
import { render } from 'astro:content';
import { publishedPosts, relatedPosts, seriesPosts } from '../lib/posts';
import BlogPost from '../layouts/BlogPost.astro';
import { postUrl, routeFromUrl } from '../lib/utils';

export async function getStaticPaths() {
  const sorted = await publishedPosts();

  return sorted.map((post, index) => ({
    params: {
      slug: routeFromUrl(postUrl(post)),
    },
    props: {
      post,
      prev: sorted[index + 1],
      next: sorted[index - 1],
      related: relatedPosts(sorted, post),
      series: seriesPosts(sorted, post),
    },
  }));
}

const { post, prev, next, related, series } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPost post={post} headings={headings} prev={prev} next={next} related={related} series={series}>
  <Content />
</BlogPost>
