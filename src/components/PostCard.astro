---
import { formatDate, postUrl, readingTime } from '../lib/utils';
import { topicUrl } from '../lib/posts';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, date, description, tags } = post.data;
const href = postUrl(post);
const readTime = readingTime(post.body ?? '');
---

<article class="post-card">
  <div class="post-meta">
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
    <span aria-hidden="true">·</span>
    <span>{readTime}</span>
  </div>
  <h3><a href={href}>{title}</a></h3>
  <p>{description}</p>
  {tags.length > 0 && (
    <ul class="tags">
      {tags.map(tag => <li><a href={topicUrl(tag)}>{tag}</a></li>)}
    </ul>
  )}
  <a class="read-more" href={href} aria-label={`Read ${title}`}>Read article <span aria-hidden="true">↗</span></a>
</article>

<style>
  .post-card {
    border-top: 1px solid var(--border);
    padding: var(--space-lg) 0;
    min-width: 0;
  }
  .post-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.6;
    flex-wrap: wrap;
    margin-bottom: .75rem;
  }
  h3 {
    font-family: var(--font-head);
    font-size: clamp(1.4rem, 3vw, 1.8rem);
    margin: 0 0 var(--space-xs);
    text-transform: none;
    line-height: 1.3;
  }
  h3 a {
    color: var(--fg);
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  p {
    color: var(--fg-muted);
    margin: var(--space-sm) 0 0;
    line-height: 1.75;
    font-size: .94rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: var(--space-md) 0 0;
  }
  .tags li {
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    margin: 0;
  }
  .tags a { color: inherit; text-decoration: none; }
  .tags li + li::before { content: "/"; color: var(--border); margin-right: .75rem; }
  .tags a:hover { color: var(--accent); }
  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: var(--space-md);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    text-underline-offset: 3px;
  }
</style>
