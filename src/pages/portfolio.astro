---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectFilter from '../components/ProjectFilter.astro';
import { workProjects, sideProjects, githubUrl, projectCategories } from '../data/projects';

const workCategories = ['all', ...projectCategories(workProjects)];
const sideCategories = ['all', ...projectCategories(sideProjects)];
---

<BaseLayout
  title="Projects"
  description="Systems and AI platforms built at Walmart Global Tech, plus public side projects."
>
  <div class="container portfolio-page">
    <h1>
      Projects<span aria-hidden="true">.</span>
    </h1>
    <p class="subtitle">
      A closer look at applied AI, operational software and distributed systems I've worked on at
      Walmart Global Tech, plus public experiments I build independently.
    </p>

    <section>
      <h2>Professional work</h2>
      <p class="section-note">
        Read the engineering case studies for selected internal platforms. The source code and
        private architecture are not public.
      </p>
      <ProjectFilter
        scope="work"
        categories={workCategories}
        label="Filter professional work by category"
      />
      <div class="grid" data-project-grid="work">
        {workProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </section>

    <section>
      <h2>Side projects</h2>
      <p class="section-note">
        Public repositories, mostly in the RAG and AI-agent space. See also{' '}
        <a href={githubUrl} target="_blank" rel="noopener noreferrer">
          github.com/ranjan-apu
        </a>
        .
      </p>
      <ProjectFilter
        scope="side"
        categories={sideCategories}
        label="Filter side projects by category"
      />
      <div class="grid" data-project-grid="side">
        {sideProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .portfolio-page {
    --max-width: 1040px;
  }
  h1 {
    font-size: clamp(2.8rem, 6vw, 4.25rem);
    letter-spacing: -0.035em;
    margin: 0 0 0.75rem;
  }
  h1 span {
    color: var(--accent);
  }
  .subtitle {
    color: var(--fg-muted);
    max-width: 60ch;
    font-size: 1.05rem;
    line-height: 1.65;
    margin-bottom: 2rem;
  }
  section {
    margin-bottom: 2.75rem;
  }
  h2 {
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    text-transform: none;
    letter-spacing: -0.03em;
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-md);
    margin-bottom: var(--space-sm);
  }
  .section-note {
    color: var(--fg-dim);
    font-size: 0.92rem;
    margin-bottom: var(--space-lg);
  }
  .section-note a {
    color: var(--fg-muted);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(1.5rem, 5vw, 4rem);
    row-gap: 0;
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
