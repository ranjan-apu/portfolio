---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectFilter from '../components/ProjectFilter.astro';
import { workProjects, sideProjects, githubUrl } from '../data/projects';
---

<BaseLayout
  title="Portfolio"
  description="Systems and AI platforms built at Walmart Global Tech, plus public side projects."
>
  <div class="container portfolio-page">
    <p class="micro-label page-kicker">Selected engineering work / Professional & personal</p>
    <h1>Portfolio<span aria-hidden="true">.</span></h1>
    <p class="subtitle">
      Production systems I've built at Walmart Global Tech, and the things I build for fun.
    </p>

    <section>
      <h2>Professional work</h2>
      <p class="section-note">
        Internal Walmart platforms — described here, but the code isn't public.
      </p>
      <ProjectFilter
        scope="work"
        categories={['all', 'systems', 'ai', 'software', 'web']}
        label="Filter professional work by category"
      />
      <div class="grid" data-project-grid="work">
        {workProjects.map(project => <ProjectCard project={project} />)}
      </div>
    </section>

    <section>
      <h2>Side projects</h2>
      <p class="section-note">
        Public repositories, mostly in the RAG and AI-agent space. See also{' '}
        <a href={githubUrl} target="_blank" rel="noopener noreferrer">github.com/ranjan-apu</a>.
      </p>
      <ProjectFilter scope="side" label="Filter side projects by category" />
      <div class="grid" data-project-grid="side">
        {sideProjects.map(project => <ProjectCard project={project} />)}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .portfolio-page { --max-width: 1040px; }
  .page-kicker { color: var(--accent); margin-bottom: 1rem; }
  h1 { font-size: clamp(3rem, 7vw, 5rem); letter-spacing: -.05em; text-transform: none; margin: 0 0 .75rem; }
  h1 span { color: var(--accent); }
  .subtitle {
    color: var(--fg-muted);
    max-width: 60ch;
    font-size: 1.05rem;
    line-height: 1.75;
    margin-bottom: var(--space-2xl);
  }
  section {
    margin-bottom: var(--space-2xl);
  }
  h2 {
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    text-transform: none;
    letter-spacing: -.03em;
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-md);
    margin-bottom: var(--space-sm);
  }
  .section-note {
    color: var(--fg-dim);
    font-size: 0.92rem;
    margin-bottom: var(--space-lg);
  }
  .section-note a {
    color: var(--fg-muted);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(1.5rem, 5vw, 4rem);
    row-gap: 0;
  }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
</style>