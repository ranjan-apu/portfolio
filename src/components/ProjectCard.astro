---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const hasLinks = Object.values(project.links).some(Boolean);
---

<article class="project-card" data-categories={project.categories.join(' ')}>
  <div class="project-topline">
    <p class="org">{project.org ?? 'Independent project'}</p>
    {project.featured && <span class="featured">Selected</span>}
  </div>
  <h3>{project.name}</h3>
  <p class="desc">{project.description}</p>
  {project.detail && <p class="detail">{project.detail}</p>}
  <ul class="categories">
    {project.categories.map(cat => <li>{cat}</li>)}
  </ul>
  {hasLinks && (
    <div class="links">
      {project.links.code && <a href={project.links.code} target="_blank" rel="noopener noreferrer">Code ↗</a>}
      {project.links.live && <a href={project.links.live} target="_blank" rel="noopener noreferrer">Live ↗</a>}
      {project.links.x && <a href={project.links.x} target="_blank" rel="noopener noreferrer">X ↗</a>}
      {project.links.instagram && <a href={project.links.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a>}
      {project.links.npm && <a href={project.links.npm} target="_blank" rel="noopener noreferrer">npm ↗</a>}
    </div>
  )}
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border-top: 1px solid var(--border);
    padding: 1.15rem 0 1.5rem;
  }
  .project-topline { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; margin-bottom: .55rem; }
  .org, .featured {
    font-family: var(--font-mono);
    font-size: .67rem;
    line-height: 1.5;
    letter-spacing: .04em;
    text-transform: uppercase;
    margin: 0;
    color: var(--fg-dim);
  }
  .featured { color: var(--accent); }
  h3 { font-family: var(--font-head); font-size: clamp(1.35rem, 2vw, 1.7rem); letter-spacing: -.025em; line-height: 1.2; margin: 0 0 .5rem; }
  .desc { color: var(--fg); margin: 0 0 .65rem; font-size: .97rem; line-height: 1.65; }
  .detail { color: var(--fg-muted); font-size: .9rem; line-height: 1.7; margin: 0 0 1rem; flex: 1; }
  .categories { display: flex; gap: .75rem; list-style: none; padding: 0; margin: auto 0 .9rem; flex-wrap: wrap; }
  .categories li { font-family: var(--font-mono); color: var(--fg-dim); font-size: .67rem; text-transform: uppercase; margin: 0; }
  .categories li + li::before { content: '/'; color: var(--border); margin-right: .75rem; }
  .links { display: flex; gap: 1.25rem; flex-wrap: wrap; }
  .links a { font-family: var(--font-mono); font-size: .72rem; text-decoration: none; }
  .links a:hover { text-decoration: underline; text-underline-offset: .2rem; }
</style>
