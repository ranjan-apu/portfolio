---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { RESUME } from '../data/resume';
import { RESUME_PATH } from '../consts';

const description = `${RESUME.name} — Software Engineer III, Walmart Global Tech. Résumé: experience, education, publications, and skills.`;
---

<BaseLayout title="Résumé" description={description} ogType="profile">
  <div class="container resume-page">
    <div class="resume-toolbar">
      <p>LaTeX original · one A4 page</p>
      <a class="download" href={RESUME_PATH} download="Apurba-Ranjan-Mohapatra-Resume.pdf">
        Download PDF <Icon name="arrow-up-right" />
      </a>
    </div>

    <!-- Mirrors public/resume.pdf. The PDF is the source of truth. -->
    <article class="resume-sheet" aria-label="Résumé">
      <header class="resume-head">
        <h1>{RESUME.name}</h1>
        <ul class="contact">
          {RESUME.contact.map((item) => (
            <li>
              {item.icon === 'linkedin' ? (
                <SocialIcon name="linkedin" />
              ) : (
                <Icon name={item.icon} />
              )}
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </header>

      <section>
        <h2>Summary</h2>
        <p class="summary">{RESUME.summary}</p>
      </section>

      <section>
        <h2>Work Experience</h2>
        {RESUME.experience.map((role) => (
          <div class="role">
            <div class="role-head">
              <h3>{role.title}</h3>
              <span class="period">{role.period}</span>
            </div>
            <ul class="bullets">
              {role.bullets.map((bullet) => (
                <li>
                  <strong>{bullet.lead}</strong> {bullet.body}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>

      <section>
        <h2>Education</h2>
        <div class="edu">
          <div class="edu-head">
            <h3>{RESUME.education.school}</h3>
            <span class="period">{RESUME.education.period}</span>
          </div>
          <div class="edu-sub">
            <span>{RESUME.education.degree}</span>
            <span>
              <strong>{RESUME.education.gradeLabel}</strong> {RESUME.education.grade}
            </span>
          </div>
        </div>
      </section>

      <section>
        <h2>Publications</h2>
        <ul class="bullets">
          {RESUME.publications.map((publication) => (
            <li>
              <strong>{publication.title}</strong> <em>{publication.venue}</em>, {publication.year}.{' '}
              <a href={publication.href}>[DOI Link]</a>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2>Skills</h2>
        <dl class="skills">
          {RESUME.skills.map((skill) => (
            <div class="skill-row">
              <dt>{skill.label}</dt>
              <dd>{skill.items}</dd>
            </div>
          ))}
        </dl>
      </section>
    </article>
  </div>
</BaseLayout>

<style>
  .resume-page {
    --max-width: 1040px;
    padding-top: 1.25rem;
  }

  .resume-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
  }
  .resume-toolbar p {
    margin: 0;
  }
  .download {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.5rem;
    padding: 0 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    white-space: nowrap;
    text-decoration: none;
  }
  .download:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* The paper sheet: A4 with the LaTeX page's own measurements (pt). */
  .resume-sheet {
    width: 210mm;
    max-width: 100%;
    min-height: 297mm;
    margin: 0 auto;
    padding: 28pt 29.77pt 26pt;
    background: #fff;
    color: #000;
    font-family: 'LM Roman 12', Georgia, serif;
    font-size: 11.96pt;
    line-height: 1.208;
    color-scheme: light;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.04);
  }
  .resume-sheet h1,
  .resume-sheet h2,
  .resume-sheet h3 {
    color: #000;
    letter-spacing: 0;
  }
  .resume-sheet h3 {
    font-family: inherit;
  }

  .resume-head h1 {
    font-family: 'LM Roman 17', Georgia, serif;
    font-size: 24.79pt;
    font-weight: 400;
    line-height: 1;
    text-align: center;
    margin: 0 0 8pt;
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 2pt;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 14.35pt;
    line-height: 1;
  }
  .contact li {
    display: inline-flex;
    align-items: center;
    gap: 2.5pt;
    margin: 0;
  }
  .contact li + li::before {
    content: '|';
    margin: 0 6pt;
    font-weight: 400;
  }
  .contact svg {
    width: 1em;
    height: 1em;
  }
  .resume-sheet a {
    color: #003399;
    text-decoration: none;
  }
  .resume-sheet a:hover {
    text-decoration: underline;
  }

  section {
    margin-top: 12pt;
  }
  section:first-of-type {
    margin-top: 10.3pt;
  }
  /* The source PDF leaves a larger gap before Education. */
  section:nth-of-type(3) {
    margin-top: 30pt;
  }
  h2 {
    font-family: 'LM Roman Caps 10', Georgia, serif;
    font-size: 17.22pt;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.01em;
    margin: 0;
    padding-bottom: 3.4pt;
    border-bottom: 0.4pt solid #000;
  }
  .summary {
    margin: 7.1pt 0 0;
    text-align: justify;
  }
  .role {
    margin-top: 8.9pt;
  }
  .role + .role {
    margin-top: 20pt;
  }
  .role-head,
  .edu-head,
  .edu-sub {
    display: flex;
    justify-content: space-between;
    gap: 12pt;
  }
  .role-head h3,
  .edu-head h3 {
    font-size: 11.96pt;
    font-weight: 700;
    margin: 0;
  }
  .period {
    font-weight: 700;
    white-space: nowrap;
  }
  .bullets {
    list-style: none;
    margin: 5.5pt 0 0;
    padding-left: 11.7pt;
  }
  .bullets li {
    position: relative;
  }
  .bullets li::before {
    content: '•';
    position: absolute;
    left: -8pt;
  }
  .bullets li + li {
    margin-top: 4.2pt;
  }
  .edu {
    margin-top: 8.9pt;
  }
  .edu-sub strong {
    font-weight: 700;
  }
  .skills {
    display: grid;
    grid-template-columns: 157.8pt 1fr;
    margin: 8.9pt 0 0;
  }
  .skill-row {
    display: contents;
  }
  .skill-row dt {
    font-weight: 700;
  }
  .skill-row dd {
    margin: 0;
  }

  @media screen and (max-width: 860px) {
    .resume-page {
      padding-top: 0.5rem;
    }
    .resume-toolbar {
      justify-content: flex-end;
      margin-bottom: 0.75rem;
    }
    .resume-toolbar p {
      display: none;
    }
    .resume-sheet {
      width: 100%;
      min-height: 0;
      padding: 24px 18px 28px;
      font-size: 11.5pt;
    }
    .resume-head h1 {
      font-size: 22pt;
    }
    .contact {
      font-size: 12pt;
      row-gap: 4pt;
    }
    .contact li + li::before {
      content: none;
    }
    .contact li {
      margin-right: 8pt;
    }
    .role-head,
    .edu-head,
    .edu-sub {
      flex-wrap: wrap;
      gap: 2pt 12pt;
    }
    .role-head .period,
    .edu-head .period {
      margin-left: auto;
    }
    .skills {
      grid-template-columns: 1fr;
      row-gap: 4pt;
    }
    .skill-row {
      display: block;
    }
  }

  @media print {
    @page {
      size: A4;
      margin: 0;
    }
    :global(.site-header),
    :global(.site-footer),
    .resume-toolbar {
      display: none !important;
    }
    :global(body) {
      background: #fff !important;
    }
    :global(main) {
      padding: 0 !important;
    }
    .resume-page {
      width: 100% !important;
      max-width: none !important;
      margin: 0 !important;
      padding: 0 !important;
    }
    .resume-sheet {
      width: 210mm;
      min-height: 297mm;
      margin: 0;
      box-shadow: none;
    }
  }
</style>
