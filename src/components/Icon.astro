---
/**
 * Single-stroke icon set. One family, one weight, no Unicode glyph stand-ins,
 * so arrows and ticks render identically on every platform.
 */
interface Props {
  name:
    'arrow-up-right' | 'arrow-right' | 'arrow-left' | 'check' | 'chevron-down' | 'mail' | 'phone';
  class?: string;
}

const { name, class: className = '' } = Astro.props;

const paths: Record<Props['name'], string> = {
  'arrow-up-right': '<path d="M7 17 17 7"/><path d="M9 7h8v8"/>',
  'arrow-right': '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
  'arrow-left': '<path d="M19 12H5"/><path d="m11 18-6-6 6-6"/>',
  check: '<path d="m5 13 4 3.5L19 6"/>',
  'chevron-down': '<path d="m6 9 6 6 6-6"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/>',
  phone:
    '<path d="M5 3h4l2 5-2.4 1.5a11 11 0 0 0 5.9 5.9L16 13l5 2v4a2 2 0 0 1-2.2 2A17 17 0 0 1 3 5.2 2 2 0 0 1 5 3Z"/>',
};
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  width="1em"
  height="1em"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>

<style>
  .icon {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: -0.08em;
  }
</style>
