---
import Icon from './Icon.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const hasLinks = !!project.caseStudySlug || Object.values(project.links).some(Boolean);
---

<article class="project-card" data-categories={project.categories.join(' ')}>
  <div class="project-topline">
    <p class="org">{project.org ?? 'Independent project'}</p>
    {project.featured && <span class="featured">Selected</span>}
  </div>
  <h3>{project.name}</h3>
  <p class="desc">{project.description}</p>
  {project.detail && <p class="detail">{project.detail}</p>}
  <ul class="categories">
    {project.categories.map((cat) => (
      <li>{cat}</li>
    ))}
  </ul>
  {hasLinks && (
    <div class="links">
      {project.caseStudySlug && (
        <a class="case-study" href={`/portfolio/${project.caseStudySlug}/`}>
          Read case study <Icon name="arrow-up-right" />
        </a>
      )}
      {project.links.code && (
        <a href={project.links.code} target="_blank" rel="noopener noreferrer">
          Code <Icon name="arrow-up-right" />
        </a>
      )}
      {project.links.live && (
        <a href={project.links.live} target="_blank" rel="noopener noreferrer">
          Live <Icon name="arrow-up-right" />
        </a>
      )}
      {project.links.x && (
        <a href={project.links.x} target="_blank" rel="noopener noreferrer">
          X <Icon name="arrow-up-right" />
        </a>
      )}
      {project.links.instagram && (
        <a href={project.links.instagram} target="_blank" rel="noopener noreferrer">
          Instagram <Icon name="arrow-up-right" />
        </a>
      )}
      {project.links.npm && (
        <a href={project.links.npm} target="_blank" rel="noopener noreferrer">
          npm <Icon name="arrow-up-right" />
        </a>
      )}
    </div>
  )}
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border-top: 1px solid var(--border);
    padding: 1.15rem 0 1.5rem;
  }
  .project-topline {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
    margin-bottom: 0.55rem;
  }
  .org,
  .featured {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    line-height: 1.5;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0;
    color: var(--fg-dim);
  }
  .featured {
    color: var(--accent);
  }
  h3 {
    font-family: var(--font-head);
    font-size: clamp(1.35rem, 2vw, 1.7rem);
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin: 0 0 0.5rem;
  }
  .desc {
    color: var(--fg);
    margin: 0 0 0.65rem;
    font-size: 0.97rem;
    line-height: 1.65;
  }
  .detail {
    color: var(--fg-muted);
    font-size: 0.9rem;
    line-height: 1.7;
    margin: 0 0 1rem;
    flex: 1;
  }
  .categories {
    display: flex;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: auto 0 0.9rem;
    flex-wrap: wrap;
  }
  .categories li {
    font-family: var(--font-mono);
    color: var(--fg-dim);
    font-size: var(--text-meta);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0;
  }
  .categories li + li::before {
    content: '/';
    color: var(--border);
    margin-right: 0.75rem;
  }
  .links {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  .links a {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
  }
  .links .case-study {
    font-weight: 600;
  }
  .links a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }
</style>
