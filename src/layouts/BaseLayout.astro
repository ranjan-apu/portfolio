---
import ThemeScript from '../components/ThemeScript.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CodeReveal from '../components/CodeReveal.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
  articleDate?: string;
}

const { title, description, ogImage, ogType = 'website', articleDate } = Astro.props;

import {
  SITE_NAME,
  SITE_TITLE,
  SITE_DESCRIPTION,
  SITE_URL,
  AUTHOR_FULL,
  AUTHOR_ROLE,
  AUTHOR_LOCATION,
  SOCIAL,
  RESUME_PATH,
} from '../consts';

const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_TITLE;
const pageDesc = description || SITE_DESCRIPTION;
const canonical = new URL(Astro.url.pathname, SITE_URL).toString();
const ogImageUrl = ogImage ? new URL(ogImage, SITE_URL).toString() : new URL('/og/default.png', SITE_URL).toString();

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: AUTHOR_FULL,
  url: SITE_URL,
  jobTitle: AUTHOR_ROLE,
  email: SOCIAL.email.replace('mailto:', ''),
  address: {
    '@type': 'PostalAddress',
    addressLocality: AUTHOR_LOCATION,
  },
  sameAs: [SOCIAL.github, SOCIAL.linkedin, SOCIAL.x],
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    credentialCategory: 'degree',
    name: 'B.Tech. in Computer Science and Engineering',
    alumniOf: 'National Institute of Technology Karnataka (NITK)',
  },
};
---

<!doctype html>
<html lang="en" data-theme="night">
  <head>
    <ThemeScript />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDesc} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE_NAME} — RSS feed`}
      href={new URL('/rss.xml', SITE_URL).toString()}
    />
    <link rel="alternate" type="application/pdf" title="Résumé (PDF)" href={RESUME_PATH} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImageUrl} />

    {articleDate && <meta property="article:published_time" content={articleDate} />}

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <title>{pageTitle}</title>
  </head>
  <body>
    <a href="#main" class="sr-only">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CodeReveal />
  </body>
</html>

<style>
  main {
    min-height: calc(100vh - 200px);
    padding: var(--space-xl) 0;
  }
</style>
