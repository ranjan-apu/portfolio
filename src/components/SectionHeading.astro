---
import Icon from './Icon.astro';

interface Props {
  title: string;
  href?: string;
  linkText?: string;
}
const { title, href, linkText } = Astro.props;
---

<div class="section-heading">
  <h2>{title}</h2>
  {href && linkText && (
    <a href={href}>
      {linkText} <Icon name="arrow-up-right" />
    </a>
  )}
</div>

<style>
  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.1rem;
  }
  h2 {
    font-size: var(--text-title);
    letter-spacing: -0.02em;
    margin: 0;
  }
  a {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-weight: 500;
    text-underline-offset: 4px;
  }
  @media (max-width: 420px) {
    .section-heading {
      align-items: start;
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
