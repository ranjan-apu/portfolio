---
import { formatDate, postUrl, readingTime } from '../lib/utils';
import { topicUrl, topicLabel } from '../lib/posts';
import Icon from './Icon.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, date, description, tags } = post.data;
const href = postUrl(post);
const readTime = readingTime(post.body ?? '');
---

<article class="post-card">
  <div class="post-meta">
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
    <span aria-hidden="true">·</span>
    <span>{readTime}</span>
  </div>
  <h3>
    <a href={href}>{title}</a>
  </h3>
  <p>{description}</p>
  {tags.length > 0 && (
    <ul class="tags">
      {tags.map((tag) => (
        <li>
          <a href={topicUrl(tag)}>{topicLabel(tag)}</a>
        </li>
      ))}
    </ul>
  )}
  <a class="read-more" href={href} aria-label={`Read ${title}`}>
    Read article <Icon name="arrow-up-right" />
  </a>
</article>

<style>
  .post-card {
    border-top: 1px solid var(--border);
    padding: 1.1rem 0;
    min-width: 0;
  }
  .post-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
    line-height: 1.6;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }
  h3 {
    font-family: var(--font-head);
    font-size: clamp(1.3rem, 2.4vw, 1.6rem);
    font-weight: var(--fw-head);
    margin: 0 0 var(--space-xs);
    letter-spacing: -0.015em;
    line-height: 1.25;
  }
  h3 a {
    color: var(--fg);
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  p {
    color: var(--fg-muted);
    margin: var(--space-sm) 0 0;
    line-height: 1.6;
    font-size: 0.94rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
  }
  .tags li {
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    margin: 0;
  }
  .tags a {
    color: inherit;
    text-decoration: none;
  }
  .tags li + li::before {
    content: '/';
    color: var(--border);
    margin-right: 0.75rem;
  }
  .tags a:hover {
    color: var(--accent);
  }
  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.75rem;
    min-height: 2.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-weight: 500;
    text-underline-offset: 3px;
  }
</style>
