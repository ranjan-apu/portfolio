---
interface Props {
  eyebrow: string;
  title: string;
  href?: string;
  linkText?: string;
}
const { eyebrow, title, href, linkText } = Astro.props;
---

<div class="section-heading">
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
  </div>
  {href && linkText && <a href={href}>{linkText} <span aria-hidden="true">↗</span></a>}
</div>

<style>
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1.1rem; }
  .eyebrow { font-family: var(--font-mono); color: var(--accent); font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; margin: 0 0 .45rem; }
  h2 { font-size: clamp(1.65rem, 4vw, 2.1rem); letter-spacing: -.03em; text-transform: none; margin: 0; }
  a { flex-shrink: 0; font-family: var(--font-mono); font-size: .74rem; font-weight: 600; text-underline-offset: 4px; }
  @media (max-width: 420px) { .section-heading { align-items: start; flex-direction: column; gap: .5rem; } }
</style>
