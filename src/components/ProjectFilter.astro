---
interface Props {
  /** Filters only cards inside the matching [data-project-grid] container. */
  scope: string;
  categories?: string[];
  /** Accessible name for the button group. Keep distinct when a page renders more than one filter bar. */
  label?: string;
}

const {
  scope,
  categories = ['all', 'software', 'ai', 'web'],
  label = 'Filter projects by category',
} = Astro.props;

const labels: Record<string, string> = {
  all: 'All',
  software: 'Software',
  ai: 'AI',
  web: 'Web',
  systems: 'Systems',
  hardware: 'Hardware',
};
---

<div class="filter-bar" role="group" aria-label={label} data-scope={scope}>
  {categories.map((cat, idx) => (
    <button
      type="button"
      data-filter={cat}
      aria-pressed={idx === 0 ? 'true' : 'false'}
      class={idx === 0 ? 'active' : ''}
    >
      {labels[cat] || (cat.charAt(0).toUpperCase() + cat.slice(1))}
    </button>
  ))}
  <span class="count" aria-live="polite"></span>
</div>

<script>
  function initProjectFilters() {
    document.querySelectorAll<HTMLElement>('.filter-bar[data-scope]').forEach((filterBar) => {
      const scope = filterBar.dataset.scope;
      if (!scope) return;

      const grid = document.querySelector<HTMLElement>(`[data-project-grid="${scope}"]`);
      if (!grid) return;

      const cards = grid.querySelectorAll<HTMLElement>('.project-card');
      const buttons = filterBar.querySelectorAll<HTMLButtonElement>('button[data-filter]');
      const countEl = filterBar.querySelector<HTMLElement>('.count');

      function applyFilter(filter: string) {
        let visible = 0;
        cards.forEach((card) => {
          const categories = (card.getAttribute('data-categories') || '').split(' ');
          const show = filter === 'all' || categories.includes(filter);
          card.style.display = show ? '' : 'none';
          if (show) visible++;
        });

        buttons.forEach((btn) => {
          const isActive = btn.getAttribute('data-filter') === filter;
          btn.setAttribute('aria-pressed', String(isActive));
          btn.classList.toggle('active', isActive);
        });

        if (countEl) {
          countEl.textContent = `${visible} project${visible === 1 ? '' : 's'}`;
        }
      }

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          applyFilter(btn.getAttribute('data-filter') || 'all');
        });
      });

      applyFilter('all');
    });
  }

  document.addEventListener('astro:page-load', initProjectFilters);
</script>

<style>
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: center;
    margin-bottom: var(--space-lg);
  }
  button {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    color: var(--fg-muted);
    padding: var(--space-xs) var(--space-md);
    border-radius: var(--radius);
    cursor: pointer;
    font: inherit;
    font-size: 0.9rem;
    text-transform: uppercase;
  }
  button:hover,
  button.active {
    border-color: var(--accent);
    color: var(--accent);
  }
  .count {
    margin-left: auto;
    color: var(--fg-dim);
    font-size: 0.9rem;
  }

  @media (max-width: 600px) {
    .count {
      width: 100%;
      margin-left: 0;
      margin-top: var(--space-sm);
    }
  }
</style>
